page {
  --ink: #14201c;
  --ink-soft: #2a3833;
  --muted: #5c6b66;
  --line: #d5deda;
  --paper: #e8eeec;
  --card: #ffffff;
  --accent: #0f766e;
  --accent-deep: #115e59;
  background: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.brand {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--ink);
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 32, 28, 0.04);
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn-primary,
.btn-primary {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
  line-height: 1.3;
}

.btn-primary::after,
.btn-primary::after {
  border: none;
}

.btn-ghost,
.btn-ghost {
  background: transparent;
  color: var(--accent-deep);
  border: 2rpx solid var(--accent);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  line-height: 1.3;
}

.btn-ghost::after,
.btn-ghost::after {
  border: none;
}

.amount {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  color: var(--accent-deep);
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #ecfdf8;
  color: var(--accent-deep);
}

.link {
  color: var(--accent);
  font-size: 24rpx;
}
