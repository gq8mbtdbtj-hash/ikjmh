<view class="page">
  <view class="card tip">
    <view class="brand tip-title">上传小票</view>
    <view class="muted">拍照或从相册选择。未配置云 OCR 时使用演示解析，请在下一页核对金额。</view>
  </view>

  <view class="card preview" wx:if="{{imagePath}}">
    <image class="img" src="{{imagePath}}" mode="aspectFit" />
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="chooseCamera">拍照</button>
    <button class="btn-ghost" bindtap="chooseAlbum">相册</button>
  </view>

  <button class="btn-primary parse" wx:if="{{imagePath}}" loading="{{parsing}}" bindtap="onParse">
    {{parsing ? '解析中…' : '解析并确认'}}
  </button>
</view>
