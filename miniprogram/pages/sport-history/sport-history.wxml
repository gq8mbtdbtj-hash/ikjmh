<view class="page">
  <view class="card head row-between">
    <text class="brand">运动历史</text>
    <text class="muted">共 {{count}} 次</text>
  </view>

  <block wx:if="{{list.length}}">
    <view
      class="card item"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onOpen"
      data-id="{{item.id}}"
      bindlongpress="onDelete"
    >
      <view class="row-between">
        <text class="title">{{item.typeName}}</text>
        <text class="amount">{{item.distanceText}}</text>
      </view>
      <view class="muted">{{item.timeText}} · {{item.durationText}} · 配速 {{item.paceText}}</view>
    </view>
  </block>
  <view class="card empty muted" wx:else>还没有运动记录。从首页「去运动」开始吧。</view>
</view>
