.hero-title {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.hero-amount-wrap {
  margin-top: 28rpx;
}

.hero-amount {
  font-size: 64rpx;
  margin-top: 4rpx;
}

.streak {
  margin-top: 24rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.actions {
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action {
  flex: 1;
}

.section-head {
  margin-bottom: 12rpx;
}

.section-title {
  font-weight: 600;
  font-size: 30rpx;
}

.item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.item-title {
  font-size: 30rpx;
  margin-bottom: 4rpx;
}

.sport-line {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
