.sport-page {
  padding: 0;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.map {
  width: 100%;
  height: 52vh;
}

.panel {
  flex: 1;
  margin: -24rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.types {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.type {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f3f7f5;
  font-size: 24rpx;
}

.type.on {
  background: #ccfbf1;
  color: var(--accent-deep);
  font-weight: 600;
}

.type.disabled {
  opacity: 0.5;
}

.metrics {
  margin-bottom: 16rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-val {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tip {
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.tip.warn {
  color: #b45309;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions button {
  flex: 1;
}

.stop {
  background: #be123c !important;
  border-color: #be123c !important;
  color: #fff !important;
}
