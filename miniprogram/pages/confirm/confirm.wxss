.preview .img {
  width: 100%;
  height: 360rpx;
  background: #f3f7f5;
  border-radius: 12rpx;
}

.mode {
  margin-top: 16rpx;
}

.label {
  margin: 20rpx 0 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.input,
.picker {
  background: #f3f7f5;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 30rpx;
}

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f3f7f5;
  font-size: 24rpx;
}

.cat.on {
  background: #ccfbf1;
  color: var(--accent-deep);
  font-weight: 600;
}

.hint {
  margin-top: 20rpx;
  line-height: 1.6;
}

.save {
  width: 100%;
}
