<view class="page">
  <view class="card preview" wx:if="{{imagePath}}">
    <image class="img" src="{{imagePath}}" mode="aspectFit" />
    <view class="chip mode">解析模式：{{modeLabel}}</view>
  </view>

  <view class="card">
    <view class="label">金额（元）</view>
    <input class="input" type="digit" value="{{amount}}" bindinput="onAmount" />

    <view class="label">商户</view>
    <input class="input" value="{{merchant}}" bindinput="onMerchant" />

    <view class="label">分类</view>
    <view class="cats">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat {{category===item.id?'on':''}}"
        data-id="{{item.id}}"
        bindtap="onCat"
      >{{item.name}}</view>
    </view>

    <view class="label">日期</view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="picker">{{date}}</view>
    </picker>

    <view class="label">备注</view>
    <input class="input" placeholder="可选" value="{{note}}" bindinput="onNote" />

    <view class="hint muted" wx:if="{{rawText}}">{{rawText}}</view>
  </view>

  <button class="btn-primary save" bindtap="onSave">确认入账</button>
</view>
